<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The pure core is compiled straight in, so the tests need none of the game or BepInEx assemblies. -->
  <ItemGroup>
    <Compile Include="..\..\src\ExiledToolkit\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The page script, as the plugin ships it, run in Jint against a fake root document. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\ExiledToolkit\toasts.js" LogicalName="ExiledToolkit.toasts.js" Link="toasts.js" />
    <EmbeddedResource Include="..\..\src\ExiledToolkit\dock.js" LogicalName="ExiledToolkit.dock.js" Link="dock.js" />
    <EmbeddedResource Include="FakePage.js" LogicalName="ExiledToolkit.Tests.FakePage.js" />
    <EmbeddedResource Include="DockFake.js" LogicalName="ExiledToolkit.Tests.DockFake.js" />
    <EmbeddedResource Include="..\..\src\ExiledToolkit\menu.js" LogicalName="ExiledToolkit.menu.js" Link="menu.js" />
    <EmbeddedResource Include="MenuFake.js" LogicalName="ExiledToolkit.Tests.MenuFake.js" />
    <EmbeddedResource Include="MenuV1.js" LogicalName="ExiledToolkit.Tests.MenuV1.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
