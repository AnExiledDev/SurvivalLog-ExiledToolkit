<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ExiledToolkit</AssemblyName>
    <RootNamespace>ExiledToolkit</RootNamespace>
    <Version>0.20.1</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">D:\Games\Survival Log\Survival Log</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
    <Interop>$(GameDir)\BepInEx\interop</Interop>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCore)\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExCore)\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExCore)\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(Interop)\AOT.dll" Private="false" />
    <Reference Include="$(Interop)\HotUpdate.dll" Private="false" />
    <Reference Include="$(Interop)\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(Interop)\Il2CppSystem.Core.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="$(Interop)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(Interop)\Vuplex.WebView.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="toasts.js" LogicalName="ExiledToolkit.toasts.js" />
    <EmbeddedResource Include="menu.js" LogicalName="ExiledToolkit.menu.js" />
    <EmbeddedResource Include="gamemenu.js" LogicalName="ExiledToolkit.gamemenu.js" />
    <EmbeddedResource Include="dock.js" LogicalName="ExiledToolkit.dock.js" />
    <EmbeddedResource Include="phone.js" LogicalName="ExiledToolkit.phone.js" />
    <EmbeddedResource Include="ui.js" LogicalName="ExiledToolkit.ui.js" />
    <EmbeddedResource Include="typing.js" LogicalName="ExiledToolkit.typing.js" />
    <EmbeddedResource Include="api.js" LogicalName="ExiledToolkit.api.js" />
  </ItemGroup>

  <!-- What the Mod Manager's Mods screen shows about this mod. -->
  <ItemGroup>
    <AssemblyMetadata Include="ModManager.Name" Value="Exiled's Toolkit&#10;Exiled 工具包" />
    <AssemblyMetadata Include="ModManager.Description" Value="A shared library for my Survival Log mods. Install it when another mod says it needs it. On its own it only changes the look and size of the phone and bag buttons on the HUD. It shows mods' short notices (toasts) next to the HUD, gives them one shared Mods button in the inventory, and applies their settings without a restart. It also keeps their HUD buttons and phone apps tidy, fits their buttons into the pause menu and title screen, lets you make their windows bigger or smaller, and stops the game's hotkeys while you type in their text boxes.&#10;我的 Survival Log 模组共用的库。其他模组说需要它时再安装。单独安装时，它只会改变 HUD 上手机和背包按钮的外观和大小。它在 HUD 旁显示模组的简短通知，在背包里给模组一个共用的「Mods」按钮，并让模组的设置无需重启就能生效。它还会让模组的 HUD 按钮和手机应用排列整齐，把模组的按钮放进暂停菜单和标题画面并保证都放得下，让你放大或缩小模组的窗口，并在你往模组的文本框里打字时屏蔽游戏的快捷键。" />
    <AssemblyMetadata Include="ModManager.Author" Value="AnExiledDev" />
    <AssemblyMetadata Include="ModManager.Category" Value="Tools" />
    <AssemblyMetadata Include="ModManager.Library" Value="true" />
    <AssemblyMetadata Include="ModManager.GameVersion" Value="1.1.20719" />
    <AssemblyMetadata Include="ModManager.Settings" Value="Live" />
    <AssemblyMetadata Include="ModManager.NexusId" Value="61" />
    <AssemblyMetadata Include="ModManager.GitHub" Value="AnExiledDev/SurvivalLog-ExiledToolkit" />
    <AssemblyMetadata Include="ModManager.Changelog" Value="https://github.com/AnExiledDev/SurvivalLog-ExiledToolkit/blob/main/CHANGELOG.md" />
  </ItemGroup>

</Project>
